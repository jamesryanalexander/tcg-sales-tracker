AUTH_USERNAME=youruser
# IMPORTANT: use the "For .env (Docker Compose)" line that `flask --app app
# hash-password` prints, NOT the raw hash. Werkzeug's hash format contains
# literal '$' characters, and Docker Compose silently blanks out anything
# that looks like "$word" in a .env file (reading it as an unset variable
# reference) unless each '$' is doubled to '$$'. If `docker compose up`
# prints "WARN ... variable is not set" with chunks of your hash as the
# variable name, this is why -- your login will silently fail even though
# the container starts fine.
AUTH_PASSWORD_HASH=replace-with-the-$$-escaped-output-of-flask-hash-password
SECRET_KEY=replace-with-output-of-python-secrets-token_hex-32
MAX_UPLOAD_MB=20
SESSION_COOKIE_SECURE=1
